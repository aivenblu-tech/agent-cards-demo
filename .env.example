# --- Server ---
# Port the app listens on (hosts like Railway/Render set PORT automatically)
PORT=3000
# Where the SQLite database file lives (created automatically)
DATA_DIR=./data

# --- Waitlist emails (Resend) ---
# The landing page's email form saves signups to the local database AND sends
# you an email notification per signup. Needs a Resend API key (resend.com).
# Without it, signups are still saved — only the email alerts are skipped.
RESEND_API_KEY=
# Where signup notification emails go.
NOTIFY_EMAIL=aivenblu@gmail.com
# The From address for those emails. Resend's demo address works without a
# verified domain, but only delivers to your Resend account's own email.
# For delivery to anyone, verify a domain in Resend and set it here, e.g.
# hello@yourdomain.com
RESEND_FROM=

# --- Default AI provider ---
# One of: anthropic, openai, gemini, deepseek, meta
DEFAULT_PROVIDER=meta

# --- LLM provider API keys (NEVER commit real keys — this file is an example only) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
META_MODEL_API_KEY=

# --- Optional model overrides (defaults shown) ---
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.0-flash
# DEEPSEEK_MODEL=deepseek-chat
# META_MODEL=muse-spark-1.3
